@model MunicipalServicesMVC.Models.EmployeeFile

@{
    ViewData["Title"] = "إدارة ملفات الموظف";

    var employeeFiles =
        ViewBag.EmployeeFiles as IEnumerable<MunicipalServicesMVC.Models.EmployeeFile>;
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white text-center">
            <h4 class="mb-0">
                إدارة ملفات الموظف
            </h4>
        </div>

        <div class="card-body">

            <h5 class="text-center mb-4">
                الموظف: @ViewBag.EmployeeName
            </h5>

            @if (TempData["FileError"] != null)
            {
                <div class="alert alert-danger text-center">
                    @TempData["FileError"]
                </div>
            }

            <!-- رفع الملفات -->
            <form asp-action="ManageFiles"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="EmployeeId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        اختر الملفات
                    </label>

                    <input type="file"
                           name="fileEmployees"
                           class="form-control"
                           multiple />
                </div>

                <div class="text-center">
                    <button type="submit"
                            class="btn btn-warning">
                        رفع الملفات
                    </button>

                    <a asp-action="Index"
                       class="btn btn-success">
                        رجوع
                    </a>
                </div>

            </form>

        </div>
    </div>


    <!-- الملفات المرفوعة -->
    <div class="card shadow mt-4">

        <div class="card-header bg-success text-white text-center">
            <h5 class="mb-0">
                الملفات المرفوعة
            </h5>
        </div>

        <div class="card-body">

            @if (employeeFiles != null && employeeFiles.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle text-center">

                        <thead class="table-success">

                            <tr>
                                <th>اسم الملف</th>
                                <th>معاينة</th>
                                <th>العمليات</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var file in employeeFiles)
                            {
                                <tr>

                                    <td>
                                        @file.Name
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(file.FileURL))
                                        {
                                            <img src="@file.FileURL"
                                                 alt="ملف الموظف"
                                                 style="width:80px;
                                                        height:80px;
                                                        object-fit:cover;
                                                        border-radius:10px;" />
                                        }
                                    </td>

                                    <td>

                                        <form asp-action="DeleteFile"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@file.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('هل أنت متأكد من حذف الملف؟');">
                                                حذف
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info text-center mb-0">
                    لا توجد ملفات مرفوعة لهذا الموظف.
                </div>
            }

        </div>
    </div>

</div>
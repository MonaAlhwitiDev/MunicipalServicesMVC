@model MunicipalServicesMVC.Models.Employee

@{
    ViewData["Title"] = "تعديل الموظف";
}

<div class="container py-4" dir="rtl">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        تعديل الموظف
                    </h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                اسم الموظف
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="JobTitle"
                                   class="form-label">
                                المسمى الوظيفي
                            </label>

                            <input asp-for="JobTitle"
                                   class="form-control" />

                            <span asp-validation-for="JobTitle"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="DepartmentId"
                                   class="form-label">
                                الإدارة
                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.DepartmentId"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-warning">
                            حفظ التعديلات
                        </button>

                        <a asp-action="Index"
                           class="btn btn-success">
                            رجوع
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
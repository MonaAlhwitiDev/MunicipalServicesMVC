@model IEnumerable<MunicipalServicesMVC.Models.Department>

@{
    ViewData["Title"] = "الإدارات";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 class="mb-0">الإدارات</h2>

                <a asp-action="Create"
                   class="btn btn-success">
                    إضافة إدارة +
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center">

                    <thead>
                        <tr>
                            <th class="bg-success text-white">الرقم</th>
                            <th class="bg-success text-white">اسم الإدارة</th>
                            <th class="bg-success text-white">عدد الموظفين</th>
                            <th class="bg-success text-white">عدد الخدمات</th>
                            <th class="bg-success text-white">الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var department in Model)
                        {
                            <tr>

                                <td>@department.Id</td>
                                <td>@department.Name</td>
                                <td>@department.Employees.Count</td>
                                <td>@department.Services.Count</td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@department.Id"
                                       class="btn btn-warning btn-sm">
                                        تعديل
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@department.Id"
                                       class="btn btn-danger btn-sm">
                                        حذف
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
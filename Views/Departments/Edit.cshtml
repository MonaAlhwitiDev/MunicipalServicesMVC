@model MunicipalServicesMVC.Models.Department

@{
    ViewData["Title"] = "تعديل الإدارة";
}

<div class="container py-4" dir="rtl">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">تعديل الإدارة</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit"
                          asp-route-uid="@Model.UID"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                اسم الإدارة
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-warning">
                            حفظ التعديلات
                        </button>

                        <a asp-action="Index"
                           class="btn btn-success">
                            رجوع
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
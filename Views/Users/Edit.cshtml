@model MunicipalServicesMVC.Models.User

@{
    ViewData["Title"] = "تعديل المستخدم";
}

<div class="container mt-4">

    <h2 class="mb-4">تعديل المستخدم</h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- اسم المستخدم -->
                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- البريد الإلكتروني -->
                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- الدور -->
                <div class="mb-3">

                    <label asp-for="RoleId"
                           class="form-label">
                        الدور
                    </label>

                    <select asp-for="RoleId"
                            asp-items="ViewBag.Roles"
                            class="form-select">

                        <option value="">
                            اختر الدور
                        </option>

                    </select>

                    <span asp-validation-for="RoleId"
                          class="text-danger">
                    </span>

                </div>


                <!-- الموظف المرتبط بالحساب -->
                <div class="mb-3">

                    <label asp-for="EmployeeId"
                           class="form-label">
                        الموظف المرتبط بالحساب
                    </label>

                    <select asp-for="EmployeeId"
                            asp-items="ViewBag.Employees"
                            class="form-select">

                        <option value="">
                            اختر الموظف
                        </option>

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="text-danger">
                    </span>

                </div>


                <!-- الأزرار -->
                <button type="submit"
                        class="btn btn-success">
                    حفظ التعديلات
                </button>

                <a asp-action="Index"
                   class="btn btn-warning">
                    رجوع
                </a>

            </form>

        </div>

    </div>

</div>
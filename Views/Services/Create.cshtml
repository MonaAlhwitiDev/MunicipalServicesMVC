@model MunicipalServicesMVC.Models.Service

@{
    ViewData["Title"] = "إضافة خدمة";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-success text-white text-center py-3">

                    <h4 class="mb-0">
                        إضافة خدمة جديدة
                    </h4>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label fw-bold">
                                اسم الخدمة
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="اكتب اسم الخدمة" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label fw-bold">
                                وصف الخدمة
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="اكتب وصف الخدمة"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="DepartmentId"
                                   class="form-label fw-bold">
                                الإدارة
                            </label>

                            <select asp-for="DepartmentId"
                                    class="form-select"
                                    asp-items="ViewBag.DepartmentId">

                                <option value="">
                                    اختر الإدارة
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-warning">
                                رجوع
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                حفظ
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
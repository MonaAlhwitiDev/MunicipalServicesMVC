@model MunicipalServicesMVC.Models.Service

@{
    ViewData["Title"] = "إضافة خدمة";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h2 class="text-center mb-4">
                        إضافة خدمة جديدة
                    </h2>

                    <form asp-action="Create">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                اسم الخدمة
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="اكتب اسم الخدمة" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                وصف الخدمة
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="اكتب وصف الخدمة">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DepartmentId" class="form-label">
                                الإدارة
                            </label>

                            <select asp-for="DepartmentId"
                                    class="form-select"
                                    asp-items="ViewBag.DepartmentId">

                                <option value="">
                                    اختر الإدارة
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                رجوع
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                حفظ
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

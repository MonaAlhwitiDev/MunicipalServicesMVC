@model IEnumerable<MunicipalServicesMVC.Models.Service>

@{
    ViewData["Title"] = "الخدمات";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 class="mb-0">
                    الخدمات
                </h2>

                <a asp-action="Create"
                   class="btn btn-success">
                    إضافة خدمة +
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle text-center">

                    <thead>

                        <tr>
                            <th class="bg-success text-white">الرقم</th>
                            <th class="bg-success text-white">اسم الخدمة</th>
                            <th class="bg-success text-white">الوصف</th>
                            <th class="bg-success text-white">الإدارة</th>
                            <th class="bg-success text-white">الإجراءات</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var service in Model)
                        {
                            <tr>

                                <td>@service.Id</td>

                                <td>@service.Name</td>

                                <td>@service.Description</td>

                                <td>@service.Department?.Name</td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@service.Id"
                                       class="btn btn-warning btn-sm">
                                        تعديل
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@service.Id"
                                       class="btn btn-danger btn-sm">
                                        حذف
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@model MunicipalServicesMVC.Models.Service

@{
    ViewData["Title"] = "حذف الخدمة";
}

<div class="container py-4" dir="rtl">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        حذف الخدمة
                    </h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-danger text-center">
                        هل أنت متأكد من حذف هذه الخدمة؟
                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            اسم الخدمة
                        </label>

                        <input value="@Model.Name"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            وصف الخدمة
                        </label>

                        <textarea class="form-control"
                                  rows="4"
                                  readonly>@Model.Description</textarea>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            الإدارة
                        </label>

                        <input value="@Model.Department?.Name"
                               class="form-control"
                               readonly />

                    </div>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <button type="submit"
                                class="btn btn-danger">
                            حذف
                        </button>

                        <a asp-action="Index"
                           class="btn btn-warning">
                            رجوع
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
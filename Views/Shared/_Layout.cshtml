<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - نظام إدارة الخدمات البلدية
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS الخاص بالنظام -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body class="bg-light">

    @{
        var employeeName =
            User.FindFirst("EmployeeName")?.Value
            ?? User.Identity?.Name
            ?? "المستخدم";

        var employeeImage =
            User.FindFirst("EmployeeImage")?.Value;

        var userRole =
            User.FindFirst(
                System.Security.Claims.ClaimTypes.Role
            )?.Value;
    }


    <!-- ========================= -->
    <!-- الشريط العلوي -->
    <!-- ========================= -->

    <nav class="navbar navbar-dark bg-success shadow-sm">

        <div class="container-fluid d-flex justify-content-between align-items-center">


            <!-- شعار واسم النظام -->
            <a class="navbar-brand d-flex align-items-center gap-3"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/tabuk-logo.png"
                     alt="شعار أمانة منطقة تبوك"
                     width="55" />

                <span class="fw-bold fs-4">
                    نظام إدارة الخدمات البلدية
                </span>

            </a>


            <!-- المستخدم المسجل -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-profile">

                    @if (!string.IsNullOrEmpty(employeeImage))
                    {
                        <img src="@employeeImage"
                             alt="صورة الموظف"
                             class="user-profile-image" />
                    }
                    else
                    {
                        <div class="user-profile-placeholder">

                            @employeeName.Substring(0, 1)

                        </div>
                    }


                    <div class="user-profile-details">

                        <span class="user-profile-name">
                            @employeeName
                        </span>

                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <span class="user-profile-role">
                                @userRole
                            </span>
                        }

                    </div>

                </div>
            }


        </div>

    </nav>


    <!-- ========================= -->
    <!-- الصفحة -->
    <!-- ========================= -->

    <div class="container-fluid">

        <div class="row">


            <!-- ========================= -->
            <!-- القائمة الجانبية -->
            <!-- ========================= -->

            <aside class="col-md-3 col-lg-2 bg-success text-white min-vh-100 p-4">

                <div class="text-center mb-4">

                    <span class="fw-bold fs-4">
                        القائمة الرئيسية
                    </span>

                </div>


                <nav class="nav flex-column">


                    <!-- الرئيسية -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        الرئيسية

                    </a>


                    <!-- الإدارات -->
                    <a asp-controller="Departments"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        الإدارات

                    </a>


                    <!-- الموظفين -->
                    <a asp-controller="Employees"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        الموظفين

                    </a>


                    <!-- الخدمات -->
                    <a asp-controller="Services"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        الخدمات

                    </a>


                    @if (User.IsInRole("مدير النظام"))
                    {

                        <!-- المستخدمين -->
                        <a asp-controller="Users"
                           asp-action="Index"
                           class="nav-link text-white rounded fs-5 fw-semibold py-3">

                            المستخدمين

                        </a>


                        <!-- الأدوار -->
                        <a asp-controller="Roles"
                           asp-action="Index"
                           class="nav-link text-white rounded fs-5 fw-semibold py-3">

                            الأدوار

                        </a>


                        <!-- الصلاحيات -->
                        <a asp-controller="Permissions"
                           asp-action="Index"
                           class="nav-link text-white rounded fs-5 fw-semibold py-3">

                            الصلاحيات

                        </a>

                    }


                    <!-- تسجيل الخروج -->
                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        تسجيل الخروج

                    </a>


                </nav>

            </aside>


            <!-- ========================= -->
            <!-- محتوى الصفحات -->
            <!-- ========================= -->

            <main class="col-md-9 col-lg-10 p-4">

                @RenderBody()

            </main>


        </div>

    </div>


    <!-- ========================= -->
    <!-- Footer -->
    <!-- ========================= -->

    <footer class="border-top bg-white text-muted text-center py-3">

        1448 - نظام إدارة الخدمات البلدية

    </footer>


    <!-- ========================= -->
    <!-- JavaScript -->
    <!-- ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - نظام إدارة الخدمات البلدية
    </title>

    <!-- Bootstrap فقط -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

</head>


<body class="bg-light">


    <!-- الشريط العلوي -->
    <nav class="navbar navbar-dark bg-success shadow-sm">

        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center gap-3"
               asp-controller="Home"
               asp-action="Index">

                <img src="/images/tabuk-logo.png"
                     alt="شعار أمانة منطقة تبوك"
                     width="55" />

                <span class="fw-bold fs-4">
                    نظام إدارة الخدمات البلدية
                </span>

            </a>

        </div>

    </nav>


    <!-- الصفحة -->
    <div class="container-fluid">

        <div class="row">


            <!-- القائمة الجانبية -->
            <aside class="col-md-3 col-lg-2 bg-success text-white min-vh-100 p-4">

                <div class="text-center mb-4">

                    <span class="fw-bold fs-4">
                        القائمة الرئيسية
                    </span>

                </div>


                <nav class="nav flex-column">


                    <!-- الرئيسية -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        🏠 الرئيسية

                    </a>


                    <!-- الإدارات -->
                    <a asp-controller="Departments"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        🏢 الإدارات

                    </a>


                    <!-- الموظفين -->
                    <a asp-controller="Employees"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        👥 الموظفين

                    </a>


                    <!-- الخدمات -->
                    <a asp-controller="Services"
                       asp-action="Index"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        ☰ الخدمات

                    </a>


                    <!-- تسجيل الخروج -->
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="nav-link text-white rounded fs-5 fw-semibold py-3">

                        ↪ تسجيل الخروج

                    </a>


                </nav>

            </aside>


            <!-- محتوى الصفحات -->
            <main class="col-md-9 col-lg-10 p-4">

                @RenderBody()

            </main>


        </div>

    </div>


    <!-- الفوتر -->
    <footer class="border-top bg-white text-muted text-center py-3">

        ©️ 1448 - نظام إدارة الخدمات البلدية

    </footer>


    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
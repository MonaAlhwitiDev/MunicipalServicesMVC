@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - نظام إدارة الخدمات البلدية</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>

<body class="bg-light">

    <div class="container">

        <div class="row justify-content-center align-items-center min-vh-100">

            <div class="col-lg-5 col-md-7">

                <div class="card shadow border-0">

                    <div class="card-body p-4">

                        <div class="text-center mb-4">

                            <img src="/images/tabuk-logo.png"
                                 alt="شعار أمانة منطقة تبوك"
                                 class="img-fluid mb-3"
                                 width="180" />

                            <h3 class="fw-bold">
                                تسجيل الدخول
                            </h3>

                        </div>

                        <div class="mb-3">

                            <label for="inputEmail"
                                   class="form-label fw-bold">
                                البريد الإلكتروني
                            </label>

                            <input id="inputEmail"
                                   type="email"
                                   class="form-control"
                                   placeholder="أدخل البريد الإلكتروني" />

                        </div>

                        <div class="mb-3">

                            <label for="inputPassword"
                                   class="form-label fw-bold">
                                كلمة المرور
                            </label>

                            <input id="inputPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="أدخل كلمة المرور" />

                        </div>

                        <div class="d-flex align-items-center gap-2 mb-3">

                            <input id="inputRememberPassword"
                                   type="checkbox"
                                   class="form-check-input m-0" />

                            <label for="inputRememberPassword"
                                   class="form-check-label">
                                تذكرني
                            </label>

                        </div>

                        <div class="text-center mb-3">

                            <a href="#"
                               class="text-warning text-decoration-none">
                                نسيت كلمة المرور؟
                            </a>

                        </div>

                        <div class="text-center">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-success px-4">
                                تسجيل الدخول
                            </a>

                        </div>

                    </div>

                    <div class="card-footer text-center text-muted">

                        نظام إدارة الخدمات البلدية

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
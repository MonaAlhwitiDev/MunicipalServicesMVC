@model MunicipalServicesMVC.Models.Permission

@{
    ViewData["Title"] = "إضافة صلاحية";
}

<div class="container mt-4">

    <h2 class="mb-4">إضافة صلاحية جديدة</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    حفظ
                </button>

                <a asp-action="Index"
                   class="btn btn-warning">
                    رجوع
                </a>

            </form>

        </div>
    </div>

</div>